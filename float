<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Anti-Gravity Button</title>
  <style>
    .antigravity {
      position: relative;
      display: inline-block;
      padding: 12px 20px;
      background: #4CAF50;
      color: white;
      border-radius: 8px;
      box-shadow: 0 8px 15px rgba(0,0,0,0.2);
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%   { transform: translateY(0); }
      50%  { transform: translateY(-10px); }
      100% { transform: translateY(0); }
    }
  </style>
</head>
<body>
  <button class="antigravity">Click Me</button>
</body>
</html>
